PORT=3020
# URL pública onde o serviço responde (sem barra no final). Pode ser um domínio inteiro ou um subcaminho.
PUBLIC_URL=https://seudominio.com/ig-auto

# Painel Meta → seu app → Instagram → "Configuração da API com login do Instagram"
IG_APP_ID=
IG_APP_SECRET=

# Token que você mesmo inventa e cola no painel da Meta (campo "Verificar token" do webhook)
VERIFY_TOKEN=
# Senha das rotas administrativas (/connect, /admin/*)
ADMIN_KEY=
# Segredo que assina o cookie do painel (gere com: openssl rand -hex 32)
SESSION_SECRET=
# @ das contas que podem entrar no painel, separados por vírgula (sem o @)
PANEL_USERS=seu.usuario

GRAPH_VERSION=v23.0
# 1 = rejeita webhooks com assinatura inválida (ligar depois do teste de fumaça)
SIGNATURE_ENFORCE=0
# 1 = responde comentários/DMs com a palavra TESTE (teste de fumaça)
SMOKE_TEST=1
# 1 = simula os envios sem chamar a Meta (bom para testar local)
DRY_RUN=0
